# CounselGrid configuration. Copy to .env and fill in. Never commit .env.
#
# Leave SUPABASE_DB_URL empty to run entirely on the local SQLite database
# (data/counselgrid.db). Nothing leaves the machine in that mode.

# Supabase > Project Settings > Database > Connection string (URI), session pooler recommended.
SUPABASE_DB_URL=

# Role the app switches to after connecting, so Row-Level Security applies to every query.
SUPABASE_DB_ROLE=counselgrid_app

# Force a backend: "sqlite" keeps all data local even if SUPABASE_DB_URL is set.
COUNSELGRID_BACKEND=

# Load the fictional demonstration data into a new, empty database. Set to false
# before first launch to start with an empty registry for real use.
COUNSELGRID_SEED_DEMO=true

# Location of the local database file (relative to the project folder or absolute).
COUNSELGRID_SQLITE_PATH=data/counselgrid.db
